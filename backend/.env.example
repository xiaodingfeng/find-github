# GitHub Personal Access Token (强烈建议配置, 将速率限制从 10 req/min 提升到 30 req/min)
# 创建: https://github.com/settings/tokens (只需 public_repo 只读权限即可)
GITHUB_TOKEN=

# Star 阈值, 默认 100
GITHUB_CRAWL_THRESHOLD=100

# 按语言迭代查询的语言数 (突破 1000 条上限), 设 0 表示不按语言拆分
GITHUB_CRAWL_TOP_LANGUAGES=20

# 每次查询最大页数 (per_page=100, 默认 10 页 = 1000 条上限)
GITHUB_CRAWL_MAX_PAGES_PER_QUERY=10

# 数据库 URL
DATABASE_URL=sqlite:///./data/findgithub.db

# 是否启用 APScheduler 内置调度
SCHEDULER_ENABLED=true

# CORS 允许的前端源
CORS_ORIGINS=http://localhost:5173

# ===== LLM 配置 (兼容 OpenAI 格式) =====
# 支持: DeepSeek / 通义千问 / OpenAI / 本地 vllm / Ollama 等
# DeepSeek: https://api.deepseek.com/v1  模型: deepseek-chat
# 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1  模型: qwen-plus
# OpenAI:   https://api.openai.com/v1  模型: gpt-4o-mini
# 本地 Ollama: http://localhost:11434/v1  模型: qwen2.5:14b
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=auto
LLM_TIMEOUT=60
LLM_CONCURRENCY=5
AI_INTERPRETATION_ENABLED=true

# ===== 管理员密码 =====
# 抓取日志页面敏感操作 (触发抓取/停止任务/全量AI解读) 需要验证此密码
ADMIN_PASSWORD=

# 管理员凭证 (用于敏感操作鉴权: 触发抓取/停止任务/全量AI解读)
# 推荐: 运行 `python -m cli hashpw` 生成哈希后填入 ADMIN_PASSWORD_HASH
# 兼容: 也可直接填 ADMIN_PASSWORD 明文 (启动时 warning, 不推荐)
# 两者均未配置时, 敏感接口返回 503 拒绝访问
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=

# 签名 token 密钥 (HMAC). 留空时启动自动生成随机值 (重启后已签发 token 失效).
# 生产环境建议固定配置, 避免重启导致所有管理员掉线.
SESSION_SECRET=

# 管理员 token 有效期 (小时), 默认 12
SESSION_TTL_HOURS=12
